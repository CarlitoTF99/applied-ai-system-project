# Copy this file to .env and paste your key. .env is git-ignored.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: model tried once if GEMINI_MODEL still fails after its retries ("none" disables it).
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# Optional: seconds to wait for each Gemini attempt (default 30).
GEMINI_TIMEOUT=30
